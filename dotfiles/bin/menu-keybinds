#!/usr/bin/env bash
set -euo pipefail

KEYBINDS=$(cat << 'EOF'
Mod + Space            Switch keyboard layout (us/ru)
Mod + Return           Terminal (Alacritty)
Mod + E                File Manager (Yazi in Alacritty)
Mod + D                App Launcher (Fuzzel)
Mod + Tab / Shift+Tab  Switch focus floating <-> tiling
Mod + Shift + Space    Toggle floating window
Mod + [ / ]            consume-or-expel-window (Left/Right)
Mod + , / .            consume-window-into-column / expel-window-from-column
Mod + Ctrl + Up/Down   Move window up/down within column
Mod + Shift + Arrows   Resize window / set-column-width / set-window-height
Mod + Ctrl + Arrows    Move window/column (move-column-left/right)
Mod + Alt + Left/Right/H/L Focus monitor (Left/Right)
Mod + Alt + Shift + Left/Right/H/L Move column to monitor (Left/Right)
Mod + Q                Close window
Mod + Shift + C        Center column
Mod + R                Cycle column width presets (1/3, 1/2, 2/3, full)
Mod + - / Mod + =      Resize column width (-10% / +10%)
Mod + F / Mod+Shift+F  Maximize column / Fullscreen window
Mod + H / J / K / L    Focus column/window (Left/Down/Up/Right)
Mod + Shift + H/J/K/L  Move column/window (Left/Down/Up/Right)
Mod + WheelDown/Up     Scroll navigate columns (Right/Left)
Mod + Shift + Wheel    Scroll switch workspaces (Down/Up)
Mod + Ctrl + Wheel     Scroll move column (Right/Left)
Mod + 1..9             Focus workspace 1..9
Mod + Shift + 1..9     Move column to workspace 1..9
Ctrl+Alt+P / Mod+Shift+E / Mod+Escape  Power menu (menu-power)
Mod + Alt + V          Clipboard history (menu-clipboard)
Mod + S                Web search (menu-websearch)
Mod + P                Power profile selector (menu-power-profile)
Mod + Shift + P        Monitors toggle menu (menu-monitors)
Mod + Ctrl + S         Switch window menu (menu-windows)
Mod + Shift + Q        Force kill active process (kill-active-process)
Mod + ` (grave)        Toggle dropdown terminal
Mod + W                Wallpaper selector (menu-wallpaper / awww)
Mod + C                Quick config editor (menu-configs)
Mod + F1               Keybinds cheatsheet (menu-keybinds)
Print / Mod+Shift+S / Mod+F6  Screenshot region (shot-region)
Alt + Print / Alt + F6 Screenshot active window (shot-active)
Mod + Print            Screenshot full display (shot-full)
EOF
)

echo "$KEYBINDS" | fuzzel --dmenu --prompt="Keybinds > " --width=70 --lines=22
